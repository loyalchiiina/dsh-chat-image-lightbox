{
    "name": "@loyalchiiina/dsh-chat-image-lightbox",
    "description": "对话里的图值得被认真看：点一下全屏灯箱，支持缩放、拖拽平移、下载另存、左右翻页，键盘与触摸操作。| Images in chat deserve a proper look: click for a full-screen lightbox with zoom, drag pan, download and prev/next navigation.",
    "version": "1.4.3",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": "./lib/index.js",
        "./client": "./lib/client.js",
        "./package.json": "./package.json"
    },
    "files": [
        "lib/**/*.js",
        "cordis.patch.yml",
        "README.md",
        "LICENSE",
        "docs/images/**"
      ],
    "license": "MIT",
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "inject": [
                "@deepseek-ai/dsh-client-runtime",
                "@deepseek-ai/dsh-client-ui-conversation"
            ],
            "platform": "web"
        }
    },
    "keywords": [
        "dsh-plugin",
        "deepseek-harness",
        "image",
        "lightbox",
        "gallery",
        "download"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/loyalchiiina/dsh-chat-image-lightbox.git"
    },
    "bugs": {
        "url": "https://github.com/loyalchiiina/dsh-chat-image-lightbox/issues"
    },
    "homepage": "https://github.com/loyalchiiina/dsh-chat-image-lightbox#readme",
    "dependencies": {
        "sharp": "0.34.4"
    }
}
